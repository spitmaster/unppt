{
  "name": "@unppt/unppt",
  "version": "0.2.6",
  "description": "PPTX 转成可嵌入任意网页、可被外部控制的 HTML 播放页（不依赖外部程序）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js",
    "./resvg.wasm": "./dist/resvg.wasm"
  },
  "bin": {
    "unppt": "dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spitmaster/unppt.git"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "html",
    "slides",
    "converter",
    "player"
  ],
  "homepage": "https://github.com/spitmaster/unppt",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@unppt/fonts": "^0.3.0"
  }
}
